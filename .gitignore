app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Netlify folder
.netlify

# Firebase report scripts — service account key grants full DB access, and
# generated reports may contain player data; neither belongs in git
tools/firebase-reports/serviceAccountKey.json
tools/firebase-reports/node_modules/
tools/firebase-reports/*.csv
